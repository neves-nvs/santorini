#!/usr/bin/env bash
set -euo pipefail

# Runs the whole Playwright suite against a freshly started app: a throwaway Postgres container, the
# server and the client, all stopped and removed afterwards. Asks before installing the browser.
#
#   scripts/e2e
#   Set SMOKE_BROWSER_CHANNEL=chrome to use an installed Google Chrome instead of Playwright's Chromium.

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The suite sends far more requests than a person would: the server's default limits would answer it with 429
export AUTH_RATE_LIMIT="${AUTH_RATE_LIMIT:-1000}"
export RATE_LIMIT="${RATE_LIMIT:-100000}"
export SMOKE_BROWSER_SET=all
export SMOKE_TEST_COMMAND="pnpm exec playwright test"
exec "$here/smoke" scripts
