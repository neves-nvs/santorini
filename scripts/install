#!/usr/bin/env bash
set -euo pipefail

# pnpm checks the manifests and lockfile and reuses the existing installation.
# Rebuild libraries in dependency order so downstream packages see current output.
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if ! command -v pnpm >/dev/null 2>&1; then
  exec nix develop "$root/packages/server" --command "$0" "$@"
fi

cd "$root"
pnpm install --frozen-lockfile --prefer-offline
pnpm run build:libraries
