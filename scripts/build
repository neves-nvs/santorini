#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if ! command -v npm >/dev/null 2>&1; then
  SANTORINI_QUIET=1 exec nix develop "$root/packages/server" --command "$0" "$@"
fi

for package in shared server client-react; do
  echo "build: packages/$package"
  cd "$root/packages/$package"
  npm run build
done
