#!/usr/bin/env bash
set -euo pipefail

# Builds the server and frontend images in parallel from docker-bake.hcl.
# Pass target names (server, client) to build only those.

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root"

REVISION="$(git rev-parse HEAD 2>/dev/null || echo unknown)" docker buildx bake "$@"
