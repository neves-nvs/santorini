#!/usr/bin/env bash
set -euo pipefail

# Builds one image: `docker-build server` or `docker-build client`.

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
revision="$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)"

case "${1:-}" in
  server)
    dockerfile=packages/server/Dockerfile
    image="${SANTORINI_SERVER_IMAGE:-santorini-server:check}"
    ;;
  client)
    dockerfile=packages/client-react/Dockerfile
    image="${SANTORINI_CLIENT_IMAGE:-santorini-client:check}"
    ;;
  *)
    echo "usage: $0 server|client" >&2
    exit 2
    ;;
esac

docker build -f "$root/$dockerfile" \
  --label "org.opencontainers.image.revision=$revision" \
  -t "$image" "$root"
