#!/usr/bin/env bash
set -euo pipefail

# Builds the server and frontend images and runs them the way they are deployed:
# Postgres on a private network, the compiled migrations from inside the server
# image, the server, and the frontend container in front of it. Everything is
# checked through the frontend, like a browser would: the page, the API and the
# WebSocket. Cleans up after itself. Set SANTORINI_SKIP_BUILD to use images that
# are already built.

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
server_image="${SANTORINI_SERVER_IMAGE:-santorini-server:check}"
client_image="${SANTORINI_CLIENT_IMAGE:-santorini-client:check}"
name="santorini-docker-check"
port="${CHECK_PORT:-13000}"
cookies="$(mktemp)"

cleanup() {
  docker rm -f "$name-web" "$name-app" "$name-db" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  rm -f "$cookies"
}
trap cleanup EXIT
cleanup

if [ -z "${SANTORINI_SKIP_BUILD:-}" ]; then
  "$root/scripts/docker-build"
fi

docker network create "$name" >/dev/null
docker run -d --name "$name-db" --network "$name" \
  -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=santorini \
  postgres:18 >/dev/null
for _ in $(seq 1 60); do
  if docker exec "$name-db" pg_isready -U postgres -d santorini >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

env_args=(
  -e JWT_SECRET=docker-check
  -e DB_HOST="$name-db"
  -e DB_USER=postgres
  -e DB_PASSWORD=postgres
  -e DB_DATABASE=santorini
)

echo "== image contents"
unwanted="$(docker run --rm -i --entrypoint node "$server_image" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
function inspect(directory) {
  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    const file = path.join(directory, entry.name);
    if (entry.name === "tests" || entry.name.includes(".test.")) console.log(file);
    if (entry.isDirectory()) inspect(file);
  }
}
for (const directory of ["/app/node_modules", "/app/src", "/app/packages"]) {
  if (fs.existsSync(directory)) console.log(directory);
}
inspect("/app/dist");
for (const file of ["/app/LICENSE", "/app/dist/THIRD_PARTY_NOTICES.txt"]) {
  if (!fs.existsSync(file) || fs.statSync(file).size === 0) console.log(`missing license notice: ${file}`);
}
NODE
)"
if [ -n "$unwanted" ]; then
  echo "FAIL unbundled dependencies, source, or tests in the server image:" >&2
  echo "$unwanted" >&2
  exit 1
fi
echo "ok   bundled server has no node_modules, source, or tests"
server_uid="$(docker run --rm --entrypoint node "$server_image" -p 'process.getuid()')"
client_uid="$(docker run --rm --entrypoint id "$client_image" -u)"
if [ "$server_uid" = 0 ] || [ "$client_uid" = 0 ]; then
  echo "FAIL a production image runs as root" >&2
  exit 1
fi
echo "ok   both images run as a non-root user"

echo "== migrations"
docker run --rm --network "$name" "${env_args[@]}" "$server_image" node dist/runMigrations.js

echo "== server and frontend"
docker run -d --name "$name-app" --network "$name" "${env_args[@]}" "$server_image" >/dev/null
docker run -d --name "$name-web" --network "$name" -p "$port:8080" \
  -e BACKEND_URL="http://$name-app:3000" "$client_image" >/dev/null
for _ in $(seq 1 30); do
  if [ "$(curl -s -o /dev/null -w '%{http_code}' "localhost:$port/api/games")" = 401 ]; then
    break
  fi
  sleep 1
done

expect_status() {
  local expected=$1 label=$2
  shift 2
  local actual
  actual="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$@" || true)"
  if [ "$actual" != "$expected" ]; then
    echo "FAIL $label: expected $expected, got $actual" >&2
    docker logs "$name-app" >&2
    docker logs "$name-web" >&2
    exit 1
  fi
  echo "ok   $label ($actual)"
}

base="localhost:$port"
json='content-type: application/json'
credentials='{"username":"docker-check","password":"docker-check-password"}'
websocket=(-H 'Connection: Upgrade' -H 'Upgrade: websocket' -H 'Sec-WebSocket-Version: 13' -H "Sec-WebSocket-Key: $(head -c 16 /dev/urandom | base64)")

expect_status 200 "GET / serves the client" "$base/"
expect_status 200 "GET /auth falls back to the client" "$base/auth"
expect_status 200 "GET /api/healthz" "$base/api/healthz"
expect_status 200 "GET /api/readyz" "$base/api/readyz"
expect_status 401 "GET /api/games without a session" "$base/api/games"

error_body="$(curl -s -X POST "$base/api/session" -H "$json" -d '{')"
case "$error_body" in
  *'"stack"'*)
    echo "FAIL error responses carry a stack trace: $error_body" >&2
    exit 1
    ;;
  *) echo "ok   error responses carry no stack trace" ;;
esac
expect_status 201 "register through /api" -X POST "$base/api/users" -H "$json" -d "$credentials"
expect_status 200 "login through /api" -c "$cookies" -X POST "$base/api/session" -H "$json" -d "$credentials"
expect_status 200 "GET /api/me with the session" -b "$cookies" "$base/api/me"

cookie_is_secure() {
  curl -s -D - -o /dev/null -X POST "$base/api/session" -H "$json" -d "$credentials" "$@" | grep -i '^set-cookie: token=' | grep -qi '; secure'
}

if cookie_is_secure; then
  echo "FAIL the session cookie is Secure over plain http" >&2
  exit 1
fi
echo "ok   the session cookie is not Secure over plain http"
if ! cookie_is_secure -H 'X-Forwarded-Proto: https'; then
  echo "FAIL the session cookie is not Secure when the proxy forwarded https" >&2
  exit 1
fi
echo "ok   the session cookie is Secure when the proxy forwarded https"
expect_status 401 "WebSocket upgrade without a ticket" "${websocket[@]}" "$base/ws"
expect_status 401 "WebSocket upgrade with only the session cookie" "${websocket[@]}" -b "$cookies" "$base/ws"
expect_status 401 "POST /api/ws-ticket without a session" -X POST "$base/api/ws-ticket"
ticket="$(curl -s -m 5 -b "$cookies" -X POST "$base/api/ws-ticket" | sed -n 's/.*"ticket":"\([^"]*\)".*/\1/p')"
expect_status 101 "WebSocket upgrade with a ticket" "${websocket[@]}" "$base/ws?ticket=$ticket"
expect_status 401 "WebSocket upgrade with the same ticket again" "${websocket[@]}" "$base/ws?ticket=$ticket"

# Run inside the production image so the check cannot resolve host dependencies.
echo "== live game in the packaged server"
docker run --rm -i --network "$name" --entrypoint node "$server_image" \
  --input-type=module - "http://$name-web:8080" < "$root/scripts/docker-game-check.mjs"

for _ in $(seq 1 35); do
  server_health="$(docker inspect --format '{{.State.Health.Status}}' "$name-app")"
  if [ "$server_health" = healthy ]; then break; fi
  sleep 1
done
if [ "$server_health" != healthy ]; then
  echo "FAIL the server image healthcheck: $server_health" >&2
  docker inspect --format '{{json .State.Health}}' "$name-app" >&2
  exit 1
fi
echo "ok   the server image healthcheck reports healthy"
