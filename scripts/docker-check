#!/usr/bin/env bash
set -euo pipefail

# Builds the server and frontend images and runs them the way they are deployed:
# Postgres on a private network, the compiled migrations from inside the server
# image, the server, and the frontend container in front of it. Everything is
# checked through the frontend, like a browser would: the page, the API and the
# WebSocket. Cleans up after itself. Set SANTORINI_SKIP_BUILD to use images that
# are already built.

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
server_image="${SANTORINI_SERVER_IMAGE:-santorini-server:check}"
client_image="${SANTORINI_CLIENT_IMAGE:-santorini-client:check}"
name="santorini-docker-check"
port="${CHECK_PORT:-13000}"
cookies="$(mktemp)"

cleanup() {
  docker rm -f "$name-web" "$name-app" "$name-db" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  rm -f "$cookies"
}
trap cleanup EXIT
cleanup

if [ -z "${SANTORINI_SKIP_BUILD:-}" ]; then
  "$root/scripts/docker-build"
fi

docker network create "$name" >/dev/null
docker run -d --name "$name-db" --network "$name" \
  -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=santorini \
  postgres:18 >/dev/null
for _ in $(seq 1 60); do
  if docker exec "$name-db" pg_isready -U postgres -d santorini >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

env_args=(
  -e JWT_SECRET=docker-check
  -e DB_HOST="$name-db"
  -e DB_USER=postgres
  -e DB_PASSWORD=postgres
  -e DB_DATABASE=santorini
)

echo "== image contents"
unwanted="$(docker run --rm --entrypoint sh "$server_image" -c '
  find . -path ./node_modules -prune -o \( -name "*.test.*" -o -name tests \) -print
  ls -d node_modules/typescript node_modules/jest 2>/dev/null || true
')"
if [ -n "$unwanted" ]; then
  echo "FAIL test files or dev dependencies in the server image:" >&2
  echo "$unwanted" >&2
  exit 1
fi
echo "ok   no test files or dev dependencies"
for image in "$server_image" "$client_image"; do
  if [ "$(docker run --rm --entrypoint id "$image" -u)" = 0 ]; then
    echo "FAIL $image runs as root" >&2
    exit 1
  fi
done
echo "ok   both images run as a non-root user"

echo "== migrations"
docker run --rm --network "$name" "${env_args[@]}" "$server_image" node dist/server/src/runMigrations.js

echo "== server and frontend"
docker run -d --name "$name-app" --network "$name" "${env_args[@]}" "$server_image" >/dev/null
docker run -d --name "$name-web" --network "$name" -p "$port:8080" \
  -e BACKEND_URL="http://$name-app:3000" "$client_image" >/dev/null
for _ in $(seq 1 30); do
  if [ "$(curl -s -o /dev/null -w '%{http_code}' "localhost:$port/api/games")" = 401 ]; then
    break
  fi
  sleep 1
done

expect_status() {
  local expected=$1 label=$2
  shift 2
  local actual
  actual="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$@" || true)"
  if [ "$actual" != "$expected" ]; then
    echo "FAIL $label: expected $expected, got $actual" >&2
    docker logs "$name-app" >&2
    docker logs "$name-web" >&2
    exit 1
  fi
  echo "ok   $label ($actual)"
}

base="localhost:$port"
json='content-type: application/json'
credentials='{"username":"docker-check","password":"docker-check-password"}'
websocket=(-H 'Connection: Upgrade' -H 'Upgrade: websocket' -H 'Sec-WebSocket-Version: 13' -H "Sec-WebSocket-Key: $(head -c 16 /dev/urandom | base64)")

expect_status 200 "GET / serves the client" "$base/"
expect_status 200 "GET /auth falls back to the client" "$base/auth"
expect_status 200 "GET /api/healthz" "$base/api/healthz"
expect_status 200 "GET /api/readyz" "$base/api/readyz"
expect_status 401 "GET /api/games without a session" "$base/api/games"
expect_status 201 "register through /api" -X POST "$base/api/users" -H "$json" -d "$credentials"
expect_status 200 "login through /api" -c "$cookies" -X POST "$base/api/session" -H "$json" -d "$credentials"
expect_status 200 "GET /api/me with the session" -b "$cookies" "$base/api/me"

cookie_is_secure() {
  curl -s -D - -o /dev/null -X POST "$base/api/session" -H "$json" -d "$credentials" "$@" | grep -i '^set-cookie: token=' | grep -qi '; secure'
}

if cookie_is_secure; then
  echo "FAIL the session cookie is Secure over plain http" >&2
  exit 1
fi
echo "ok   the session cookie is not Secure over plain http"
if ! cookie_is_secure -H 'X-Forwarded-Proto: https'; then
  echo "FAIL the session cookie is not Secure when the proxy forwarded https" >&2
  exit 1
fi
echo "ok   the session cookie is Secure when the proxy forwarded https"
expect_status 401 "WebSocket upgrade without a session" "${websocket[@]}" "$base/ws"
expect_status 101 "WebSocket upgrade with the session" "${websocket[@]}" -b "$cookies" "$base/ws"
