{
  "name": "@santorini/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and constants shared by the Santorini server and client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./api/openapi.yaml",
    "./asyncapi.yaml": "./api/asyncapi.yaml"
  },
  "files": [
    "dist",
    "api"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
