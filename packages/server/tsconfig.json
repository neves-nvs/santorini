{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "outDir": "./dist",
    "strict": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
