# ==========================================
# Server Configuration
# ==========================================

# The port on which the server will run, 1 to 65535.
# Default: 3000 if not specified.
PORT=

# ==========================================
# JWT Configuration
# ==========================================

# Secret key used to sign and verify JWT tokens.
# This should be a long, random string.
# Example: "your-super-secret-key"
# REQUIRED in production. Only `npm run dev` (NODE_ENV=development) can go
# without: it generates one into packages/server/.dev-jwt-secret and reuses it.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API and open WebSockets.
# Each one is scheme://host[:port]: no path, no trailing slash, no default port
# (80 for http, 443 for https). Example: https://santorini.example,http://localhost:5174
# Defaults to the React dev server (http://localhost:5174). Requests from the
# server's own origin are always allowed.
ALLOWED_ORIGINS=

# Which proxies in front of the server to believe about the client address and
# scheme (X-Forwarded-For and X-Forwarded-Proto): a number of hops, or the
# names, addresses or CIDR ranges Express accepts. Secure cookies and the rate
# limit depend on it. Defaults to loopback and private addresses.
TRUST_PROXY=

# Set to "false" to stop new accounts from being created (POST /users answers 403).
# Defaults to enabled.
REGISTRATION_ENABLED=

# Login and registration requests allowed per client every 15 minutes. Defaults to 20.
AUTH_RATE_LIMIT=

# Requests allowed per client every minute, on every route. Defaults to 300.
RATE_LIMIT=

# ==========================================
# Database Configuration
# ==========================================

# The hostname or IP address of your database server.
# Example: "localhost" for local development, or an IP like "192.168.1.100"
DB_HOST=

# The port on which the database server is running.
# Default: 5432 for PostgreSQL.
DB_PORT=

# The name of the database you are connecting to.
# Example: "auth", "mydatabase", etc.
DB_DATABASE=

# The username for your database connection.
# Example: "postgres", "admin", etc.
DB_USER=

# The password for your database connection.
# Make sure this is kept secure!
# REQUIRED in production (NODE_ENV=production); optional in development.
DB_PASSWORD=

# ==========================================
# Logging Configuration
# ==========================================

# The level of logging detail.
# Winston logging levels: [error, warn, info, http, verbose, debug, silly]
# - error: Logs only errors
# - warn: Logs warnings and errors
# - info: Logs general information, warnings, and errors
# - http: Logs HTTP requests
# - verbose: Logs more detailed information
# - debug: Logs detailed debugging information
# - silly: Logs everything, even the most trivial information
LOG_LEVEL=http

# Force logs to be enabled, even in testing environments.
# Set to "true" to enable logging in all environments.
FORCE_LOGS=false
