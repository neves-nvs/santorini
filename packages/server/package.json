{
  "name": "santorini-backend",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/main.ts",
    "test": "vitest run",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "build": "tsdown",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "lint": "eslint --fix",
    "migrate": "tsx src/runMigrations.ts",
    "migrate:prod": "node dist/runMigrations.js",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "../../scripts/test-coverage server",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --config vitest.concurrency.config.mts",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc",
    "knip": "knip --dependencies"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@santorini/engine": "workspace:*",
    "@santorini/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-redact": "^3.5.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.8",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "winston": "^3.13.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/fast-redact": "^3.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^6.15.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express-openapi-validator": "^5.6.2",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "kysely-ctl": "^0.22.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
