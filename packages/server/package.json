{
  "name": "santorini-backend",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "start": "node dist/server/src/main.js",
    "clean": "rm -rf dist",
    "build": "tsc",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "lint": "eslint --fix",
    "migrate": "tsx src/runMigrations.ts",
    "migrate:prod": "node dist/server/src/runMigrations.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "docker-build": "docker build --build-context shared=../shared --label org.opencontainers.image.revision=$(git rev-parse HEAD) -t ${SANTORINI_SERVER_IMAGE:-santorini-server:check} .",
    "typecheck": "tsc -p tests/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "fs-extra": "^11.4.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.8",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "winston": "^3.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^9.8.0",
    "globals": "^15.8.0",
    "jest": "^29.7.0",
    "kysely-ctl": "^0.22.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
