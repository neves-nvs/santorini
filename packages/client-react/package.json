{
  "name": "santorini-client-react",
  "version": "1.0.0",
  "description": "React + Three.js frontend for Santorini board game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "preview": "vite preview",
    "knip": "knip --dependencies",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "../../scripts/test-coverage client-react",
    "test:e2e": "../../scripts/e2e",
    "test:e2e:ui": "node scripts/ensure-browser.mjs && playwright test --ui",
    "test:e2e:headed": "node scripts/ensure-browser.mjs && playwright test --headed",
    "test:e2e:screenshots": "../../scripts/e2e-ui-review",
    "test:smoke": "node scripts/ensure-browser.mjs \"$SMOKE_BROWSER_CHANNEL\" && playwright test -c playwright.smoke.config.ts"
  },
  "keywords": [
    "santorini",
    "board-game",
    "react",
    "three.js"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@santorini/shared": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@react-three/test-renderer": "^9.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
